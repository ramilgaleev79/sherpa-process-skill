      <Description></Description>
      <IsPSVerified>true</IsPSVerified>
      <ParentID>00000000-0000-0000-0000-000000000000</ParentID>
      <StorageSelectors></StorageSelectors>
      <Content>&lt;ToolboxItemSettings DisplayName=&quot;Лог&quot; InternalName=&quot;Log&quot; FriendlyName=&quot;Позволяет выводить в лог произвольные сообщения и/или значения переменных в процессе работы сценария робота. Сообщения будут доступны для просмотра в панели Лог программы-дизайнера, а также в текстовых файлах логов программы-робота.&quot; Width=&quot;100&quot; Height=&quot;100&quot; PathToImage=&quot;ExternalToolboxes\Image\ico_Log.png&quot; PathToToolboxImage=&quot;{x:Null}&quot; ImageType=&quot;TopImage&quot; NoDelete=&quot;False&quot; Invisible=&quot;False&quot; Proportional=&quot;True&quot; Version=&quot;174&quot; LinuxAvailable=&quot;True&quot; Code=&quot;&amp;#xA;function Log{{{block_id}}}&amp;#xA;{   &amp;#xA;    try&amp;#xA;    {&amp;#xA;        $Value          = {{{Value}}};&amp;#xA;        $ShowStatus     = ${{{ShowStatus}}};&amp;#xA;        $SendOrkest     = ${{{SendOrkest}}};&amp;#xA;        $IsScreenshot   = ${{{IsScreenshot}}};&amp;#xA;        $MakeScreenshot = ${{{MakeScreenshot}}};&amp;#xA;    &amp;#xA;        $ValueStr = VarToString($Value); &amp;#xA;         &amp;#xA;        $val = _shield $ValueStr;&amp;#xA;        if($ShowStatus)&amp;#xA;        {       &amp;#xA;            Write-Host(&amp;quot;&amp;lt;block&amp;gt;&amp;lt;ID&amp;gt;{{{block_native_id}}}&amp;lt;/ID&amp;gt;&amp;lt;InternalName&amp;gt;ShowStatus&amp;lt;/InternalName&amp;gt;&amp;lt;UITextValue&amp;gt;$val&amp;lt;/UITextValue&amp;gt;&amp;lt;/block&amp;gt;&amp;quot;); &amp;#xA;        }&amp;#xA;        &amp;#xA;        if($SendOrkest -or $IsScreenshot)&amp;#xA;        {                      &amp;#xA;            if($val.Length -eq 0)&amp;#xA;            {&amp;#xA;                $val = &amp;quot;Screenshot &amp;quot;+[DateTime]::Now.ToString();&amp;#xA;            }&amp;#xA;            Write-Host(&amp;quot;&amp;lt;block&amp;gt;&amp;lt;ID&amp;gt;{{{block_native_id}}}&amp;lt;/ID&amp;gt;&amp;lt;InternalName&amp;gt;SendLogOrkest&amp;lt;/InternalName&amp;gt;&amp;lt;UITextValue&amp;gt;$val&amp;lt;/UITextValue&amp;gt;&amp;lt;UITextType&amp;gt;{{{Level}}}&amp;lt;/UITextType&amp;gt;&amp;lt;IsScreenshot&amp;gt;{{{IsScreenshot}}}&amp;lt;/IsScreenshot&amp;gt;&amp;lt;/block&amp;gt;&amp;quot;); &amp;#xA;        }&amp;#xA;        &amp;#xA;        $xmlvar = &amp;quot;&amp;quot;;&amp;#xA;        try&amp;#xA;        {&amp;#xA;            $xmlvar = $script:__BinFormatter.vartoxmlraw($Value);&amp;#xA;        }&amp;#xA;        catch{}       &amp;#xA;        if($script:__LogCacheEnabled)&amp;#xA;        {&amp;#xA;            $script:__LogCache = $script:__LogCache + &amp;quot;{{{block_native_id}}} &amp;quot; + $script:__BinFormatter.tobase64($ValueStr) + [Environment]::NewLine;&amp;#xA;        }&amp;#xA;        Write-Host(&amp;quot;&amp;lt;info&amp;gt;&amp;lt;ID&amp;gt;{{{block_native_id}}}&amp;lt;/ID&amp;gt;&amp;lt;InternalName&amp;gt;Log&amp;lt;/InternalName&amp;gt;&amp;lt;InternalValue&amp;gt;$val&amp;lt;/InternalValue&amp;gt;$xmlvar&amp;lt;/info&amp;gt;&amp;quot;);&amp;#xA;        if($MakeScreenshot)&amp;#xA;        {&amp;#xA;            $psresultstr = Read-Host(&amp;quot;&amp;lt;block&amp;gt;&amp;lt;ID&amp;gt;{{{block_native_id}}}&amp;lt;/ID&amp;gt;&amp;lt;InternalName&amp;gt;MakeScreenshot&amp;lt;/InternalName&amp;gt;&amp;lt;ProcessID&amp;gt;&amp;lt;/ProcessID&amp;gt;&amp;lt;ScreenshotToLog&amp;gt;True&amp;lt;/ScreenshotToLog&amp;gt;&amp;lt;/block&amp;gt;&amp;quot;); &amp;#xA;            $psResult    = [MainHelpers.PSResult]::Deserialize($psresultstr);&amp;#xA;            if(-not $__Error.CheckResult($psResult))&amp;#xA;            {&amp;#xA;                {{{ScreenshotFile}}} = $psResult.Result;&amp;#xA;            }&amp;#xA;        }           &amp;#xA;    }&amp;#xA;    catch &amp;#xA;    { &amp;#xA;    }  &amp;#xA;    $script:__LastBlockID = &amp;quot;{{{block_native_id}}}&amp;quot;;&amp;#xA;    $script:__NextBlockID = &amp;quot;{{{connector-Next}}}&amp;quot;;&amp;#xA;}                   &amp;#xA;                &quot; ProtoName=&quot;&quot; TextColor=&quot;#FF000000&quot; Language=&quot;&quot; UrlVideo=&quot;{x:Null}&quot; DerivedFrom=&quot;&quot; NoResize=&quot;False&quot; Container=&quot;False&quot; MouseOverColor=&quot;Gray&quot; MouseOverFill=&quot;Transparent&quot; IsExpressionOnPause=&quot;False&quot; ExpressionOnPause=&quot;&quot; IsCollapsedBlock=&quot;False&quot; Breakpoint=&quot;False&quot; DirivedFrom=&quot;&quot; xmlns=&quot;clr-namespace:ToolboxDesigner.Core;assembly=DiagramDesigner&quot; xmlns:av=&quot;http://schemas.microsoft.com/winfx/2006/xaml/presentation&quot; xmlns:s=&quot;clr-namespace:System;assembly=mscorlib&quot; xmlns:x=&quot;http://schemas.microsoft.com/winfx/2006/xaml&quot;>&lt;ToolboxItemSettings.PathStyle>&lt;av:Style TargetType=&quot;av:Path&quot;>&lt;av:Style.BasedOn>&lt;av:Style TargetType=&quot;av:Path&quot;>&lt;av:Style.Resources>&lt;av:ResourceDictionary />&lt;/av:Style.Resources>&lt;av:Setter Property=&quot;av:Shape.Fill&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#FFFFFFFF&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Stroke&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#FF41B1E1&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.StrokeThickness&quot;>&lt;av:Setter.Value>&lt;s:Double>2&lt;/s:Double>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.StrokeLineJoin&quot;>&lt;av:Setter.Value>&lt;x:Static Member=&quot;av:PenLineJoin.Round&quot; />&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Stretch&quot;>&lt;av:Setter.Value>&lt;x:Static Member=&quot;av:Stretch.Fill&quot; />&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:UIElement.IsHitTestVisible&quot;>&lt;av:Setter.Value>&lt;s:Boolean>False&lt;/s:Boolean>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:UIElement.SnapsToDevicePixels&quot;>&lt;av:Setter.Value>&lt;s:Boolean>True&lt;/s:Boolean>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;/av:Style>&lt;/av:Style.BasedOn>&lt;av:Style.Resources>&lt;av:ResourceDictionary />&lt;/av:Style.Resources>&lt;av:Setter Property=&quot;av:Path.Data&quot;>&lt;av:Setter.Value>&lt;av:StreamGeometry>M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;/av:Style>&lt;/ToolboxItemSettings.PathStyle>&lt;ToolboxItemSettings.PathStyle_DragThumb>&lt;av:Style TargetType=&quot;av:Path&quot;>&lt;av:Style.BasedOn>&lt;av:Style TargetType=&quot;av:Path&quot;>&lt;av:Style.BasedOn>&lt;av:Style TargetType=&quot;av:Path&quot;>&lt;av:Style.Resources>&lt;av:ResourceDictionary />&lt;/av:Style.Resources>&lt;av:Setter Property=&quot;av:Shape.Fill&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#FFFFFFFF&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Stroke&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#FF41B1E1&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.StrokeThickness&quot;>&lt;av:Setter.Value>&lt;s:Double>2&lt;/s:Double>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.StrokeLineJoin&quot;>&lt;av:Setter.Value>&lt;x:Static Member=&quot;av:PenLineJoin.Round&quot; />&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Stretch&quot;>&lt;av:Setter.Value>&lt;x:Static Member=&quot;av:Stretch.Fill&quot; />&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:UIElement.IsHitTestVisible&quot;>&lt;av:Setter.Value>&lt;s:Boolean>False&lt;/s:Boolean>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:UIElement.SnapsToDevicePixels&quot;>&lt;av:Setter.Value>&lt;s:Boolean>True&lt;/s:Boolean>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;/av:Style>&lt;/av:Style.BasedOn>&lt;av:Style.Resources>&lt;av:ResourceDictionary />&lt;/av:Style.Resources>&lt;av:Setter Property=&quot;av:Path.Data&quot;>&lt;av:Setter.Value>&lt;av:StreamGeometry>M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;/av:Style>&lt;/av:Style.BasedOn>&lt;av:Style.Resources>&lt;av:ResourceDictionary />&lt;/av:Style.Resources>&lt;av:Setter Property=&quot;av:UIElement.IsHitTestVisible&quot;>&lt;av:Setter.Value>&lt;s:Boolean>True&lt;/s:Boolean>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Fill&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#00FFFFFF&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;av:Setter Property=&quot;av:Shape.Stroke&quot;>&lt;av:Setter.Value>&lt;av:SolidColorBrush>#00FFFFFF&lt;/av:SolidColorBrush>&lt;/av:Setter.Value>&lt;/av:Setter>&lt;/av:Style>&lt;/ToolboxItemSettings.PathStyle_DragThumb>&lt;ToolboxItemSettings.Properties>&lt;PropertiesCollection Capacity=&quot;8&quot;>&lt;Property Name=&quot;Value&quot; Tooltip=&quot;[Любой тип данных] Числовая, текстовая константа (в кавычках), имя переменной (начинающееся с $) или любое выражение, значение которого будет выведено в лог в процессе работы сценария робота. Значение может в том числе иметь сложный тип данных, например Список, Таблица или Словарь.&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Expression&quot; Value=&quot;&amp;quot;готово&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;AnyDataType&quot; EnumVariants=&quot;{x:Null}&quot; Caption=&quot;Значение&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;MakeScreenshot&quot; Tooltip=&quot;Создает скриншот и сохраняет его в папке с логами&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Bool&quot; Value=&quot;&amp;quot;&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;&quot; Caption=&quot;Сделать скриншот&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;SendOrkest&quot; Tooltip=&quot;Если выбрано, то текст будет также логироваться в оркестратор, если подключение к нему активно&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Bool&quot; Value=&quot;&amp;quot;&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;&quot; Caption=&quot;Оркестратор. Логировать&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;IsScreenshot&quot; Tooltip=&quot;Если выбрано, то будет создан скриншот экрана и отправлен в оркестратор, если подключение к нему активно&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Bool&quot; Value=&quot;&amp;quot;&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;&quot; Caption=&quot;Оркестратор. Скриншот&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;Level&quot; Tooltip=&quot;Уровень сообщения при отправке лога в оркестратор&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Enum&quot; Value=&quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;Info;Critical;Error;Warning;Debug&quot; Caption=&quot;Оркестратор. Уровень&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;ShowStatus&quot; Tooltip=&quot;Если выбрано, то текст будет также выводиться в статусе, в верхней части экрана&quot; CatalogName=&quot;Main properties&quot; Type=&quot;Bool&quot; Value=&quot;&amp;quot;&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;&quot; Caption=&quot;Отображать в статусе&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;Property Name=&quot;ScreenshotFile&quot; Tooltip=&quot;[Текст] Возвращается полный путь к созданному файлу скриншота&quot; CatalogName=&quot;Output&quot; Type=&quot;Variable&quot; Value=&quot;&amp;quot;&amp;quot;&quot; Visible=&quot;True&quot; DefaultValue=&quot;&amp;quot;&amp;quot;&quot; ValueType=&quot;&quot; EnumVariants=&quot;&quot; Caption=&quot;Файл скриншота&quot; ProtoName=&quot;&quot; ReadOnly=&quot;False&quot; IsRequired=&quot;False&quot; IsPSVerified=&quot;True&quot; />&lt;/PropertiesCollection>&lt;/ToolboxItemSettings.Properties>&lt;ToolboxItemSettings.ConnectorsSettings>&lt;ConnectorsSettingsCollection Capacity=&quot;4&quot;>&lt;ConnectorSettings Name=&quot;Input&quot; Orientation=&quot;Top&quot; RelativePosition=&quot;0.5,0&quot; MaxInConnections=&quot;100&quot; MaxOutConnections=&quot;0&quot; Color=&quot;#FF000000&quot; Caption=&quot;&quot; />&lt;ConnectorSettings Name=&quot;InputLeft&quot; Orientation=&quot;Left&quot; RelativePosition=&quot;0,0.5&quot; MaxInConnections=&quot;100&quot; MaxOutConnections=&quot;0&quot; Color=&quot;#FF000000&quot; Caption=&quot;&quot; />&lt;ConnectorSettings Name=&quot;Next&quot; Orientation=&quot;Bottom&quot; RelativePosition=&quot;0.5,1&quot; MaxInConnections=&quot;0&quot; MaxOutConnections=&quot;1&quot; Color=&quot;#FF000000&quot; Caption=&quot;&quot; />&lt;/ConnectorsSettingsCollection>&lt;/ToolboxItemSettings.ConnectorsSettings>&lt;/ToolboxItemSettings></Content>
