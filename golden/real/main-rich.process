      <StorageSelectors></StorageSelectors>
      <Content>&lt;ToolboxItemSettings DisplayName="REST Клиент" InternalName="RestClient" FriendlyName="REST Клиент. Позволяет выполнять Get, Post, Put, Delete. Options запросы" Width="200" Height="75" PathToImage="ExternalToolboxes\Image\ico_Web (HTTP).png" PathToToolboxImage="{x:Null}" ImageType="LeftImage" NoDelete="False" Invisible="False" Proportional="True" Version="35" LinuxAvailable="True" Code="&amp;#xA;function RestClient{{{block_id}}}&amp;#xA;{     &amp;#xA;    try&amp;#xA;    {&amp;#xA;        $__Error.Enter(&amp;quot;{{{block_native_id}}}&amp;quot;, &amp;quot;{{{ErrorLevel}}}&amp;quot;,&amp;quot;{{{ErrorDirection}}}&amp;quot;,&amp;quot;{{{ReportLevel}}}&amp;quot;,&amp;quot;{{{ErrorMessage}}}&amp;quot;);&amp;#xA;        $__Error.AddConnectors(&amp;quot;{{{connector-Error}}}&amp;quot;, &amp;quot;{{{connectorRight}}}&amp;quot;, &amp;quot;{{{connectorBottom}}}&amp;quot;);&amp;#xA;        &amp;#xA;        $Url             = {{{Url}}};&amp;#xA;        $TypeRequest     = &amp;quot;{{{TypeRequest}}}&amp;quot;;&amp;#xA;        $Encoding        = &amp;quot;{{{Encoding}}}&amp;quot;;&amp;#xA;        $BasicUsername   = {{{BasicUsername}}};&amp;#xA;        $BasicPasswordObj   = {{{BasicPassword}}};&amp;#xA;        $PreAuthenticate = ${{{PreAuthenticate}}};&amp;#xA;        $AcceptHeader    = {{{AcceptHeader}}};&amp;#xA;        $ListParams      = {{{ListParams}}};&amp;#xA;        $ListHeaders     = {{{ListHeaders}}};&amp;#xA;        $ListCookies     = {{{ListCookies}}};&amp;#xA;        $ListFiles       = {{{ListFiles}}};&amp;#xA;        $ContentBody     = {{{ContentBody}}};&amp;#xA;        $ContentType     = {{{ContentType}}}; &amp;#xA;        $Timeout         = {{{Timeout}}};&amp;#xA;            &amp;#xA;        $resultrequest = &amp;quot;&amp;quot;; &amp;#xA;        &amp;#xA;        $Timeout = $Timeout * 1000;&amp;#xA;            &amp;#xA;        $BasicPassword = _checkpassword($BasicPasswordObj); &amp;#xA;            &amp;#xA;        if(!$script:__HttpHelpersClient)&amp;#xA;        {&amp;#xA;            $script:__HttpHelpersClient  = [HttpHelpers.ClassMain]::new();&amp;#xA;        }&amp;#xA;        &amp;#xA;        if($Encoding -eq &amp;quot;UTF8&amp;quot;) { $script:__HttpHelpersClient.Encoding = [System.Text.Encoding]::UTF8; }&amp;#xA;        else { $script:__HttpHelpersClient.Encoding = [System.Text.Encoding]::Default; }&amp;#xA;                     &amp;#xA;&amp;#xA;        $script:__HttpHelpersClient.BasicUsername = $BasicUsername;&amp;#xA;        $script:__HttpHelpersClient.BasicPassword = $BasicPassword;    &amp;#xA;        $script:__HttpHelpersClient.Timeout = $Timeout;&amp;#xA;        &amp;#xA;        $script:__HttpHelpersClient.AcceptHeader = $AcceptHeader;&amp;#xA;        $script:__HttpHelpersClient.ListParams = $ListParams;&amp;#xA;        $script:__HttpHelpersClient.ListHeaders = $ListHeaders;&amp;#xA;        $script:__HttpHelpersClient.ListCookies = $ListCookies;&amp;#xA;        $script:__HttpHelpersClient.ListFiles = $ListFiles;&amp;#xA;        $script:__HttpHelpersClient.ContentBody = $ContentBody; &amp;#xA;        $script:__HttpHelpersClient.ContentType = $ContentType;&amp;#xA;                   &amp;#xA;        $httpresult = $script:__HttpHelpersClient.Execute($Url, $TypeRequest);&amp;#xA;        {{{ResultStatusCode}}} = $httpresult.StatusCode; &amp;#xA;        if($httpresult.IsError) { $__Error.Exception($httpresult.ErrorMessage); return; }&amp;#xA;       &amp;#xA;        {{{Result}}} = $httpresult.Content; &amp;#xA;        {{{ResultCookies}}} = $httpresult.Cookies; &amp;#xA;        {{{ResultHeaders}}} = $httpresult.Headers; &amp;#xA;        {{{ResultUrl}}} = $httpresult.Url;        &amp;#xA;    }&amp;#xA;    catch &amp;#xA;    {     &amp;#xA;        $__Error.ExceptionCatch($_);&amp;#xA;        return;&amp;#xA;    } &amp;#xA;    &amp;#xA;    $__Error.Quit();&amp;#xA;}&amp;#xA;" TextColor="#FF000000" ProtoName="" Language="" UrlVideo="{x:Null}" DerivedFrom="" NoResize="False" Container="False" MouseOverColor="Gray" MouseOverFill="Transparent" IsExpressionOnPause="False" ExpressionOnPause="" IsCollapsedBlock="False" Breakpoint="False" DirivedFrom="" xmlns="clr-namespace:ToolboxDesigner.Core;assembly=DiagramDesigner" xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"&gt;&lt;ToolboxItemSettings.PathStyle&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FFFFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FF3AC40C&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeThickness"&gt;&lt;av:Setter.Value&gt;&lt;s:Double&gt;2&lt;/s:Double&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeLineJoin"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:PenLineJoin.Round" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stretch"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:Stretch.Fill" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;False&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.SnapsToDevicePixels"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Path.Data"&gt;&lt;av:Setter.Value&gt;&lt;av:StreamGeometry&gt;M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/ToolboxItemSettings.PathStyle&gt;&lt;ToolboxItemSettings.PathStyle_DragThumb&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.BasedOn&gt;&lt;av:Style TargetType="av:Path"&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FFFFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#FF3AC40C&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeThickness"&gt;&lt;av:Setter.Value&gt;&lt;s:Double&gt;2&lt;/s:Double&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.StrokeLineJoin"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:PenLineJoin.Round" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stretch"&gt;&lt;av:Setter.Value&gt;&lt;x:Static Member="av:Stretch.Fill" /&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;False&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:UIElement.SnapsToDevicePixels"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:Path.Data"&gt;&lt;av:Setter.Value&gt;&lt;av:StreamGeometry&gt;M0,0L80,0 80,20 0,20z&lt;/av:StreamGeometry&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/av:Style.BasedOn&gt;&lt;av:Style.Resources&gt;&lt;av:ResourceDictionary /&gt;&lt;/av:Style.Resources&gt;&lt;av:Setter Property="av:UIElement.IsHitTestVisible"&gt;&lt;av:Setter.Value&gt;&lt;s:Boolean&gt;True&lt;/s:Boolean&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Fill"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#00FFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;av:Setter Property="av:Shape.Stroke"&gt;&lt;av:Setter.Value&gt;&lt;av:SolidColorBrush&gt;#00FFFFFF&lt;/av:SolidColorBrush&gt;&lt;/av:Setter.Value&gt;&lt;/av:Setter&gt;&lt;/av:Style&gt;&lt;/ToolboxItemSettings.PathStyle_DragThumb&gt;&lt;ToolboxItemSettings.Properties&gt;&lt;PropertiesCollection Capacity="32"&gt;&lt;Property Name="Url" Tooltip="[Текст] Ссылка на Web-страницу, к которой необходимо отправить HTTP-запрос. Должна начинаться протоколом, например: &amp;quot;http://www.mydomain.com/list.php&amp;quot;" CatalogName="Required" Type="Expression" Value="$uri " Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="URL" ProtoName="" ReadOnly="False" IsRequired="True" IsPSVerified="True" /&gt;&lt;Property Name="TypeRequest" Tooltip="Выбор типа запроса. Возможные варианты: Get, Options, Post, Put, Delete" CatalogName="Main properties" Type="Enum" Value="Post" Visible="True" DefaultValue="" ValueType="" EnumVariants="Get;Post;Put;Delete;Head;Options;Patch;Merge;Copy;Search" Caption="Тип запроса" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="Encoding" Tooltip="Кодировка Web-страницы" CatalogName="Main properties" Type="Enum" Value="UTF8" Visible="True" DefaultValue="" ValueType="" EnumVariants="UTF8;Ansi" Caption="Кодировка" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="BasicUsername" Tooltip="[Текст] Логин для сетевой авторизации" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="Логин" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="BasicPassword" Tooltip="[Текст/SecureString] Пароль для сетевой авторизации" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text/SecureString" EnumVariants="" Caption="Пароль" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="PreAuthenticate" Tooltip="Показывает, необходима ли предварительная проверка подлинности данного запроса." CatalogName="Main properties" Type="Bool" Value="False" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="" EnumVariants="" Caption="PreAuthenticate" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="AcceptHeader" Tooltip="[Текст] Заголовок Accept для запроса. Например: &amp;quot;application/json&amp;quot;, &amp;quot;application/xml&amp;quot;" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="Accept Заголовок" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ListParams" Tooltip="[Словарь] Передаваемые в запросе параметры" CatalogName="Main properties" Type="Expression" Value="$Parameter" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Hashtable" EnumVariants="" Caption="Параметры" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ListHeaders" Tooltip="[Словарь] Передаваемые в запросе заголовки" CatalogName="Main properties" Type="Expression" Value="$Headers" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Hashtable" EnumVariants="" Caption="Заголовки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ListCookies" Tooltip="[Список объектов] Список куков. Данное свойство должно содержать список из объектов Cookie. Список можно получить с помощью блока &amp;quot;Таблица Данных в Куки&amp;quot;, с помощью блока &amp;quot;Получить Куки&amp;quot; из палитры &amp;quot;Автоматизация браузеров&amp;quot;, использовав выходное свойство &amp;quot;Куки&amp;quot; этого блока" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="ListOfObjects" EnumVariants="" Caption="Куки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ListFiles" Tooltip="[Словарь] Передаваемые в запросе файлы. Например: @{&amp;quot;file.txt&amp;quot;=&amp;quot;c:\file.txt&amp;quot;}" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Hashtable" EnumVariants="" Caption="Файлы" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ContentBody" Tooltip="[Текст] Содержание POST/PUT/DELETE-запроса" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="Содержание запроса" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ContentType" Tooltip="[Текст] Заголовок Content-Type (MIME тип), указывающий клиенту, какой будет тип передаваемого контента. Например: &amp;quot;application/json&amp;quot;, &amp;quot;application/xml&amp;quot;, &amp;quot;application/x-www-form-urlencoded&amp;quot;, &amp;quot;multipart/form-data&amp;quot;" CatalogName="Main properties" Type="Expression" Value="" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="Content-Type Заголовок" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="Timeout" Tooltip="[Число] Время ожидания в секундах" CatalogName="Main properties" Type="Expression" Value="30" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Number" EnumVariants="" Caption="Время ожидания" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="Result" Tooltip="[Текст] Возвращает результат запроса" CatalogName="Output" Type="Variable" Value="$ResponseContent" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Text" EnumVariants="" Caption="Результат" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ResultStatusCode" Tooltip="[Число] Код ответа HTTP" CatalogName="Output" Type="Variable" Value="$ResultStatusCode" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Number" EnumVariants="" Caption="Код ответа" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ResultHeaders" Tooltip="[Словарь] Словарь с заголовками ответа" CatalogName="Output" Type="Variable" Value="$DictHeaders" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="Hashtable" EnumVariants="" Caption="Заголовки ответа" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ResultCookies" Tooltip="[Список] Список куков. Список содержит объекты Cookie. Для работы с объектами смотрите подсказку в редакторе выражений" CatalogName="Output" Type="Variable" Value="$ListCookies" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="List" EnumVariants="" Caption="Куки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ResultUrl" Tooltip="[Текст] Текущий Url. Данный Url может быть полезен если произошел редирект на другую страницу" CatalogName="Output" Type="Variable" Value="$ResponseUrl" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="" EnumVariants="" Caption="Текущий Url" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ErrorLevel" Tooltip="Выбор уровня обработки ошибок. Возможные значения: &amp;quot;Default&amp;quot; - по умолчанию; &amp;quot;Ignore&amp;quot; - ошибки игнорируются; &amp;quot;Handle&amp;quot; - ошибки обрабатываются. Если выбрано значение &amp;quot;Default&amp;quot;, то будет использоваться значение блока &amp;quot;Старт&amp;quot; данной диаграммы" CatalogName="Error processing" Type="Enum" Value="Default" Visible="True" DefaultValue="" ValueType="" EnumVariants="Default;Ignore;Handle" Caption="Уровень обработки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ReportLevel" Tooltip="Выбор уровня сообщений, которые будут выводить блоки при работе. Возможные значения: &amp;quot;Default&amp;quot; - по умолчанию; &amp;quot;Release&amp;quot; - вывод отключен; &amp;quot;Debug&amp;quot; - вывод основной информации; &amp;quot;Detailed&amp;quot; - вывод подробной информации. Если выбрано значение &amp;quot;Default&amp;quot;, то будет использоваться значение блока &amp;quot;Старт&amp;quot; данной диаграммы" CatalogName="Error processing" Type="Enum" Value="Default" Visible="True" DefaultValue="" ValueType="" EnumVariants="Default;Release;Debug;Detailed;Output" Caption="Уровень сообщений" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;Property Name="ErrorMessage" Tooltip="[Текст] Возвращает подробную информацию об ошибке в случае некорректного выполнения работы блока" CatalogName="Error processing" Type="Variable" Value="$ErrorMessage" Visible="True" DefaultValue="&amp;quot;&amp;quot;" ValueType="" EnumVariants="" Caption="Текст ошибки" ProtoName="" ReadOnly="False" IsRequired="False" IsPSVerified="True" /&gt;&lt;/PropertiesCollection&gt;&lt;/ToolboxItemSettings.Properties&gt;&lt;ToolboxItemSettings.ConnectorsSettings&gt;&lt;ConnectorsSettingsCollection Capacity="4"&gt;&lt;ConnectorSettings Name="Input" Orientation="Top" RelativePosition="0.5,0" MaxInConnections="100" MaxOutConnections="0" Color="#FF000000" Caption="" /&gt;&lt;ConnectorSettings Name="Error" Orientation="Right" RelativePosition="1,0.5" MaxInConnections="0" MaxOutConnections="1" Color="#FFFF0000" Caption="Если ошибка" /&gt;&lt;ConnectorSettings Name="InputLeft" Orien